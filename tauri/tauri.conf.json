{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "app": {
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1234",
    "removeUnusedCommands": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tg"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "SocialNetworking",
    "copyright": "GPL-3.0. Based on Telegram Web A; connection fallbacks from tg-ws-proxy (MIT)",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Telegram client with liquid glass design",
    "targets": [
      "nsis"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "publisher": "Glass"
  },
  "identifier": "app.glass.desktop",
  "productName": "Glass",
  "version": "0.1.0"
}